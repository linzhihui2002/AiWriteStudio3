# Trae 编辑器内部文档
.trae/

# ── PC 客户端：独立 GitHub 仓库（ai-write-studio-client），不入主仓库 ──
pc-client/

# ── 调研归档：本地资料，不上传 ──
docs/调研归档/

# ── 求职/个人素材与视频：隐私内容，不上传 ──
项目经历-*.md
*.mp4
*.mov
*.webm

# 第三方参考项目（各自为独立 git 仓库，不纳入本仓库）
projects/

# 含 API Key 的敏感文件，禁止提交
模型API.md

# ── 工作台运行时（隔离原则：运行时产物一律不入库）──
.workbench/
.writerHelper/
workbench/vendor/dsh/node_modules/
workbench/frontend/dist/

# ── dsh 技能同步产物（源目录为 skills/，此处为自动生成的投影，不入库）──
.dsh/

# ── PC 客户端（独立实例，数据与构建产物不入库）──
pc-client/data/

# ── 依赖与构建产物 ──
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 凭据与密钥（FR-MODEL-003 兜底，防误提交）──
secrets.json
*.secrets.json
.env
.env.*
!.env.example

# ── 编辑器与系统 ──
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.log
